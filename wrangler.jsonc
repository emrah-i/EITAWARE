{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eitaware",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["*/5 * * * *"] },
  "env": {
    "staging": {
      "name": "eitaware-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "SITE_URL": "http://127.0.0.1:8787",
        "CHECKOUT_ENABLED": "false",
        "STRIPE_MODE": "test",
        "TAX_READY": "false",
        "EMAIL_READY": "false",
        "EMAIL_FROM": "EITAWARE <notifications@updates.eitaware.com>",
        "ORDER_EMAIL": "orders@eitaware.com",
        "SUPPORT_EMAIL": "support@eitaware.com",
        "MCF_SELLER_SKU": ""
      },
      "d1_databases": [{ "binding": "DB", "database_name": "eitaware-staging", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }],
      "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }]
    },
    "production": {
      "name": "eitaware",
      "workers_dev": false,
      "routes": [{ "pattern": "eitaware.com", "custom_domain": true }, { "pattern": "www.eitaware.com", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "SITE_URL": "https://eitaware.com",
        "CHECKOUT_ENABLED": "false",
        "STRIPE_MODE": "live",
        "TAX_READY": "false",
        "EMAIL_READY": "false",
        "EMAIL_FROM": "EITAWARE <notifications@updates.eitaware.com>",
        "ORDER_EMAIL": "orders@eitaware.com",
        "SUPPORT_EMAIL": "support@eitaware.com",
        "MCF_SELLER_SKU": ""
      },
      "d1_databases": [{ "binding": "DB", "database_name": "eitaware-production", "database_id": "00000000-0000-0000-0000-000000000002", "migrations_dir": "migrations" }],
      "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }]
    }
  }
}
