{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eitaware",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": []
  },
  "env": {
    "staging": {
      "name": "eitaware-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "SITE_URL": "https://eitaware.com",
        "EMAIL_FROM": "EITAWARE <support@eitaware.com>",
        "SUPPORT_EMAIL": "support@eitaware.com"
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ],
      "workers_dev": false,
      "preview_urls": false,
      "triggers": {
        "crons": []
      }
    },
    "production": {
      "name": "eitaware",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "eitaware.com",
          "custom_domain": true
        },
        {
          "pattern": "www.eitaware.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "SITE_URL": "https://eitaware.com",
        "EMAIL_FROM": "EITAWARE <support@eitaware.com>",
        "SUPPORT_EMAIL": "support@eitaware.com"
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ],
      "preview_urls": false,
      "triggers": {
        "crons": []
      }
    }
  },
  "preview_urls": false,
  "vars": {
    "EMAIL_FROM": "EITAWARE <support@eitaware.com>",
    "SUPPORT_EMAIL": "support@eitaware.com"
  }
}
